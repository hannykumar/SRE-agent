    {
      "incident_type": "CrashLoopBackOff",
      "summary": "Pods restart repeatedly because the workload crashes or is killed by the platform.",
      "keywords": ["crashloop", "oomkilled", "oom", "out of memory", "restart", "backoff", "killed"],
      "runbook_files": ["01_crashloopbackoff_oomkilled.md", "03_high_memory_leak.md"],
      "discriminating_tools": ["get_pod_status", "describe_pod", "get_metrics", "get_pod_logs", "get_recent_deploys"],
      "confirmation_rules": [
        {
          "rule_id": "crashloop_oomkilled_reason",
          "all": [{"path": "pod_describe.last_state.terminated.reason", "equals": "OOMKilled"}],
          "confidence": 0.97,
          "citations": ["tool:describe_pod"],
          "reason": "The pod termination reason is OOMKilled."
        },
        {
          "rule_id": "crashloop_memory_and_logs",
          "all": [
            {"path": "metrics.memory_percent", "gte": 90},
            {"path": "logs_tail", "contains": "out of memory"}
          ],
          "confidence": 0.9,
          "citations": ["tool:get_metrics", "tool:get_pod_logs"],
          "reason": "Memory saturation and out-of-memory logs confirm the crash pattern."
        },
        {
          "rule_id": "crashloop_restart_signal",
          "all": [
            {"path": "pod_status.restarts", "gte": 5},
            {"path": "pod_status.reason", "contains": "CrashLoop"}
          ],
          "confidence": 0.75,
          "citations": ["tool:get_pod_status"],
          "reason": "Restart count and pod reason both show a crash loop."
        }
      ],
      "verification_rules": [
        {"metric": "error_rate_percent", "direction": "decrease", "optional": true},
        {"metric": "memory_percent", "direction": "decrease", "optional": true},
        {"log_absent": ["out of memory", "oomkilled"], "optional": true}
      ],
      "safe_actions": [
        {
          "action_type": "gitops_scale_deployment",
          "conditions": [
            {"path": "incident.config_management", "equals": "gitops"},
            {"path": "pod_status.replicas", "lte": 1}
          ],
          "params": {"replicas": 2},
          "reason": "Increase replicas through GitOps because this workload is config-managed."
        },
        {
          "action_type": "scale_deployment",
          "conditions": [{"path": "pod_status.replicas", "lte": 1}],
          "params": {"replicas": 2},
          "reason": "Reduce pressure on the single crashing replica."
        },
        {
          "action_type": "restart_pod",
          "conditions": [],
          "reason": "Clear the unstable pod after crash evidence was confirmed."
        }
      ]
    },
